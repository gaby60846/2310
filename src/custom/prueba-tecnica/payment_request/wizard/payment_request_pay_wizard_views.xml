<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_request_pay_wizard_view_form" model="ir.ui.view">
        <field name="name">payment.request.pay.wizard.form</field>
        <field name="model">payment.request.pay.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar Pago Contable">
                <group>
                    <field name="payment_request_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <field name="request_amount"/>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="payment_date"/>
                    </group>
                    <group>
                        <field name="payment_currency_id"/>
                        <field name="payment_amount"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm_payment" string="Generar Pago" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
