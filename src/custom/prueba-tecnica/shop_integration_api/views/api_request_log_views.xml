<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="api_request_log_view_tree" model="ir.ui.view">
        <field name="name">api.request.log.tree</field>
        <field name="model">api.request.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="1" decoration-danger="status_code &gt;= 400" decoration-success="status_code &gt;= 200 and status_code &lt; 300">
                <field name="create_date" string="Fecha y hora"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="status_code" widget="badge"/>
                <field name="duration_ms"/>
                <field name="user_id"/>
                <field name="ip_address"/>
            </tree>
        </field>
    </record>

    <record id="api_request_log_view_search" model="ir.ui.view">
        <field name="name">api.request.log.search</field>
        <field name="model">api.request.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="endpoint"/>
                <field name="user_id"/>
                <field name="status_code"/>
                <filter name="errors" string="Errores (&gt;= 400)" domain="[('status_code', '&gt;=', 400)]"/>
                <filter name="success" string="Exitosas (&lt; 400)" domain="[('status_code', '&lt;', 400)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_endpoint" string="Endpoint" context="{'group_by': 'endpoint'}"/>
                    <filter name="group_status" string="Código HTTP" context="{'group_by': 'status_code'}"/>
                    <filter name="group_user" string="Usuario" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="api_request_log_action" model="ir.actions.act_window">
        <field name="name">Logs de API</field>
        <field name="res_model">api.request.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="api_request_log_view_search"/>
    </record>
</odoo>
